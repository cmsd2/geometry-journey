  {
   "cell_type": "code",
   "source": "/* --- Ad and ad --- */\n/* NOTE: written with ordinary two-argument functions rather than functions\n   returning lambdas.  Maxima's lambda does not close over the enclosing\n   argument reliably here, and the higher-order version failed with\n   \"The value $G is not of type LIST\". */\nLb : [ matrix([0,0,0],[0,0,-1],[0,1,0]),\n       matrix([0,0,1],[0,0,0],[-1,0,0]),\n       matrix([0,-1,0],[1,0,0],[0,0,0]) ]$\nvec3(M) := [ M[3][2], M[1][3], M[2][1] ]$      /* inverse hat map */\nAdM(gg, Y) := ratsimp( gg . Y . invert(gg) )$\n\n/* matrix of Ad_g and of ad_X in the basis (L₁,L₂,L₃): column j = image of L_j */\nAdmat(gg) := transpose( apply(matrix,\n               makelist( vec3(trigsimp(AdM(gg, Lb[j]))), j, 1, 3)) )$\nadmat(X)  := transpose( apply(matrix,\n               makelist( vec3(br(X, Lb[j])), j, 1, 3)) )$\n\ngr : tidy( matrixexp(th*Lb[3]) )$\nprint(\"Ad_g(X) = g X g⁻¹ for g = exp(θL₃):\")$\nprint(\"   Ad_g(L₁) = \", trigsimp( AdM(gr, Lb[1]) ))$\nprint(\"   still skew ? \",\n      is( ratsimp(trigsimp( AdM(gr,Lb[1]) + transpose(AdM(gr,Lb[1])) ))\n          = zeromatrix(3,3) ))$\nprint(\"   Conjugation preserves the algebra, so Ad : G → GL(g) is a\")$\nprint(\"   representation on the 3-dimensional space so(3).\")$\n\n/* ad_X = d/dt|₀ Ad_{exp(tX)} */\nprint(\"\")$\nprint(\"ad_X(Y) = d/dt|₀ Ad_{exp(tX)}(Y), with X = L₃ :\")$\nfor j : 1 thru 3 do block([D],\n  D : ratsimp( subst( th = 0,\n        diff( trigsimp( AdM(gr, Lb[j]) ), th) ) ),\n  print(\"   Y = L\", j, \" :  derivative − [L₃, L\", j, \"] = \",\n        ratsimp( D - br(Lb[3], Lb[j]) )) )$\nprint(\"   The bracket IS the derivative of conjugation.  That is what it\")$\nprint(\"   measures: the first-order failure of exp(tX) to commute with Y.\")$\n\n/* the adjoint representation of so(3) is the standard one */\nprint(\"\")$\nprint(\"matrices of ad_{Lᵢ} in the basis (L₁,L₂,L₃):\")$\nfor i : 1 thru 3 do\n  print(\"   ad_L\", i, \" = \", admat(Lb[i]),\n        \"   equals L\", i, \" ? \", is( admat(Lb[i]) = Lb[i] ))$\nprint(\"   so(3) acts on itself exactly as it acts on ℝ³: the adjoint\")$\nprint(\"   representation IS the standard one.  Consistent with 5.01 —\")$\nprint(\"   the hat map identifies so(3) with ℝ³ and the bracket with ×.\")$\n\n/* Ad_{exp X} = e^{ad_X} */\nprint(\"\")$\nprint(\"Ad_{exp X} = e^{ad_X}, both as 3×3 matrices in the basis:\")$\nlhsA : trigsimp( Admat(gr) )$\nrhsA : trigsimp( tidy( matrixexp( th * admat(Lb[3]) ) ) )$\nprint(\"   Ad_{exp(θL₃)} = \", lhsA)$\nprint(\"   e^{θ ad_{L₃}}  = \", rhsA)$\nprint(\"   difference     = \", ratsimp(trigsimp( lhsA - rhsA )))$\nprint(\"   An exponential in the GROUP equals an exponential in the ALGEBRA.\")$\nprint(\"   For so(3) both sides are the rotation matrix itself, because the\")$\nprint(\"   adjoint representation is the standard one.\")$",
   "metadata": {},
