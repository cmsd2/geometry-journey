  {
   "cell_type": "code",
   "source": "/* --- Gauss–Bonnet as the Euler class, ∫ K dA / 2π = χ --- */\n/* Stage 3 machinery: for a parametrised surface r(u,v), with\n   c = r_u × r_v and W = EG − F² = |c|²,\n      K  = [ (r_uu·c)(r_vv·c) − (r_uv·c)² ] / W²      (each of L,M,N\n                                                        carries a 1/√W)\n      dA = √W\n   so the integrand of ∫K dA is that numerator over W^{3/2}.\n   (A first version of this cell divided by W instead, and the sphere's\n   answer came out proportional to R₀² — which is how the slip was\n   caught: χ cannot depend on the radius.) */\ndot3(a,b) := a[1]*b[1] + a[2]*b[2] + a[3]*b[3]$\ncrs3(a,b) := [ a[2]*b[3]-a[3]*b[2], a[3]*b[1]-a[1]*b[3], a[1]*b[2]-a[2]*b[1] ]$\n\nKdA(rr_, uu, vv) := block([ru, rv, ruu, ruv, rvv, cc, W],\n  ru : map(lambda([e], diff(e, uu)), rr_),\n  rv : map(lambda([e], diff(e, vv)), rr_),\n  ruu : map(lambda([e], diff(e, uu)), ru),\n  ruv : map(lambda([e], diff(e, vv)), ru),\n  rvv : map(lambda([e], diff(e, vv)), rv),\n  cc : crs3(ru, rv),\n  W  : trigsimp( dot3(ru,ru)*dot3(rv,rv) - dot3(ru,rv)^2 ),\n  trigsimp( ( dot3(ruu,cc)*dot3(rvv,cc) - dot3(ruv,cc)^2 )\n            / (W * sqrt(W)) ) )$\n\n/* --- the round sphere --- */\nassume(R0 > 0, u > 0, u < %pi)$\nrsph : [ R0*sin(u)*cos(v), R0*sin(u)*sin(v), R0*cos(u) ]$\nisph : KdA(rsph, u, v)$\nprint(\"sphere of radius R₀:\")$\nprint(\"   K dA integrand = \", isph, \"   — R₀ has cancelled already\")$\nprint(\"   ∫K dA = \", ratsimp( integrate(integrate(isph, v, 0, 2*%pi),\n                                        u, 0, %pi) ))$\nprint(\"   χ = ∫K dA / 2π = \", ratsimp( integrate(integrate(isph, v, 0, 2*%pi),\n                                                 u, 0, %pi) / (2*%pi) ),\n      \"   ✓  χ(S²) = 2\")$\n\n/* --- the torus of revolution (4.06's) --- */\nrtor : [ (2 + cos(u))*cos(v), (2 + cos(u))*sin(v), sin(u) ]$\nitor : KdA(rtor, u, v)$\nprint(\"\")$\nprint(\"torus of revolution, tube 1, centre 2:\")$\nprint(\"   K dA integrand = \", itor, \"   (= K · dA = cos u/(2+cos u) · (2+cos u))\")$\nprint(\"   ∫K dA = \", ratsimp( integrate(integrate(itor, v, 0, 2*%pi),\n                                        u, 0, 2*%pi) ))$\nprint(\"   χ = 0  ✓.  4.06 found K positive on the outside and negative on\")$\nprint(\"   the inside; this says they cancel EXACTLY, which topology forces\")$\nprint(\"   and no reshaping of the tube can disturb.\")$\n\n/* --- a surface with non-constant curvature --- */\nrell : [ sin(u)*cos(v), sin(u)*sin(v), 2*cos(u) ]$      /* ellipsoid a=1, c=2 */\niell : KdA(rell, u, v)$\nprint(\"\")$\nprint(\"ellipsoid of revolution, semi-axes (1,1,2):\")$\nprint(\"   integrand at v = 0 : \", subst(v = 0, iell))$\nprint(\"   independent of v, so ∫dv contributes 2π.\")$\nqell : quad_qags( subst(v = 0, iell), u, 0, %pi )$\nprint(\"   ∫₀^π … du = \", qell[1], \"   (estimated error \", qell[2], \")\")$\nprint(\"   χ = 2π·that/2π = \", qell[1], \"   ✓  still 2\")$\nprint(\"\")$\nprint(\"K is not constant on the ellipsoid — larger at the poles, smaller at\")$\nprint(\"the equator — and the integral does not notice.  That is what a\")$\nprint(\"characteristic class is: a number no deformation of the geometry can\")$\nprint(\"change, only a change of topology.\")$\n\n/* --- and the hyperbolic side --- */\nprint(\"\")$\nprint(\"closed hyperbolic surfaces (4.07): area = 2π|χ| with K = −1, so\")$\nprint(\"   ∫K dA / 2π = −area/2π = χ\")$\nfor gen : 2 thru 4 do\n  print(\"      genus \", gen, \" : area \", float(4*%pi*(gen-1)),\n        \"   ∫K dA/2π = \", -4*(gen-1)/2, \"   χ = \", 2-2*gen)$",
   "metadata": {},
   "execution_count": 3,
