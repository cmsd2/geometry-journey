  {
   "cell_type": "code",
   "source": "/* --- The reflection counts, made explicit --- */\n\n/* TWO reflections in parallel mirrors  →  a translation by twice the gap */\nM1 : reflect_line(0, [0, 0])$      /* mirror: y = 0 */\nM2 : reflect_line(0, [0, 1])$      /* mirror: y = 1, parallel to it */\nprint(\"two parallel mirrors, gap 1:\")$\nprint(\"  M2·M1 = \", tsimp(M2 . M1), \"  = translation by (0, 2)\")$\n\n/* TWO reflections in mirrors meeting at angle γ  →  rotation by 2γ */\nN1 : reflect_line(0,   [0, 0])$\nN2 : reflect_line(π/6, [0, 0])$\nprint(\"\")$\nprint(\"two mirrors meeting at π/6:\")$\nprint(\"  N2·N1     = \", tsimp(N2 . N1))$\nprint(\"  Rot(π/3)  = \", tsimp(rotate_about(π/3, [0, 0])), \"  — identical\")$\n\n/* THREE reflections  →  a glide reflection.\n   Take the glide from §4: reflect in y = 0, then translate by (3, 0).\n   Write the translation as two reflections in mirrors ⊥ to the x-axis. */\nG  : tsimp( translate([3, 0]) . reflect_line(0, [0, 0]) )$\nP1 : reflect_line(π/2, [0,   0])$   /* mirror: the y-axis      */\nP2 : reflect_line(π/2, [3/2, 0])$   /* mirror: x = 3/2         */\nprint(\"\")$\nprint(\"glide (reflect in y=0, slide by 3):\")$\nprint(\"  G           = \", G)$\nprint(\"  P2·P1·M1    = \", tsimp(P2 . P1 . M1))$\nprint(\"  difference  = \", tsimp(G - P2 . P1 . M1), \"  (must be 0)\")$\n\n/* And the parity check: determinant of the linear part flips with each mirror */\nlin_det(M) := tsimp( M[1][1]*M[2][2] - M[1][2]*M[2][1] )$\nprint(\"\")$\nprint(\"det of linear part — one mirror: \", lin_det(M1),\n      \"   two: \", lin_det(tsimp(N2 . N1)),\n      \"   three: \", lin_det(G))$",
   "metadata": {},
   "execution_count": 19,
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "two parallel mirrors, gap 1:\n  M2·M1 =  matrix([1,0,0],[0,1,2],[0,0,1])   = translation by (0, 2)\ntwo mirrors meeting at π/6:\n  N2·N1     =  matrix([1/2,-(sqrt(3)/2),0],[sqrt(3)/2,1/2,0],[0,0,1])\n  Rot(π/3)  =  matrix([1/2,-(sqrt(3)/2),0],[sqrt(3)/2,1/2,0],[0,0,1])\n                — identical\nglide (reflect in y=0, slide by 3):\n  G           =  matrix([1,0,3],[0,-1,0],[0,0,1])\n  P2·P1·M1    =  matrix([1,0,3],[0,-1,0],[0,0,1])\n  difference  =  matrix([0,0,0],[0,0,0],[0,0,0])   (must be 0)\ndet of linear part — one mirror:  -1    two:  1    three:  -1"
     ]
    }
   ]
