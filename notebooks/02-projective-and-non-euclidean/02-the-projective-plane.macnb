     "name": "stdout",
     "output_type": "stream",
     "text": [
      "A' =  [a+1,1,1]    B' =  [1,b+1,1]    C' =  [1,1,c+1]\nO on AA'?  true    O on BB'?  true    O on CC'?  true\nP = AB ∩ A'B' =  [a,-b,0]\nQ = BC ∩ B'C' =  [0,b,-c]\nR = CA ∩ C'A' =  [-a,0,c]\ndet[P,Q,R] =  0    ⟹ P, Q, R are collinear\naxis of perspective =  [b*c,a*c,a*b]\nR lies on it?  true\nunnormalised check — P, Q, R =  [2296,-1886,-3854] ,  [5734,-1880,-5922] ,\n                               [-12212,-5504,172]\ndet[P,Q,R] =  0    collinear ✓"
     ]
    }
   ]
  },
  {
   "cell_type": "code",
   "source": "/* A Desargues configuration with pleasant affine coordinates.\n   Perspective from the origin: each primed vertex is a scaling of its partner. */\nOa : [0, 0]$\nAa : [1, 3]$    Ba : [4, 1]$    Ca : [2, -2]$\nka : 9/5$       kb : 5/2$       kc : 7/5$\nAa2 : ka*Aa$    Ba2 : kb*Ba$    Ca2 : kc*Ca$\n\nhA : embed(Aa)$  hB : embed(Ba)$  hC : embed(Ca)$\nhA2: embed(Aa2)$ hB2: embed(Ba2)$ hC2: embed(Ca2)$\n\nPp : meet( join(hA, hB), join(hA2, hB2) )$\nQp : meet( join(hB, hC), join(hB2, hC2) )$\nRp : meet( join(hC, hA), join(hC2, hA2) )$\n\nprint(\"P = \", chart(Pp))$\nprint(\"Q = \", chart(Qp))$\nprint(\"R = \", chart(Rp))$\nprint(\"det[P,Q,R] = \", ratsimp(det3(Pp, Qp, Rp)), \"  — collinear\")$\nprint(\"axis = \", ratsimp(join(Pp, Qp)))$",
   "metadata": {},
   "execution_count": 6,
   "outputs": [
