     "text": [
      "P =  [-(53/7),61/7]\nQ =  [2/11,-(52/11)]\nR =  [19/5,-11]\ndet[P,Q,R] =  0   — collinear\naxis =  [-(2277/2),-(6567/10),-(14487/5)]"
     ]
    }
