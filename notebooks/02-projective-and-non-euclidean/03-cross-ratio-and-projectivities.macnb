    {
      "cell_type": "code",
      "source": "/* --- Any frame to any other frame --- */\n/* Both must be in general position: with a = (0,0,1), b = (1,0,1), c = (0,1,1),\n   a fourth point (β, γ, α+β+γ) is admissible only when α, β, γ are all nonzero.\n   (5,−2,3) would give α = 0 — it lies on BC — so we take (2,3,4) instead. */\nF : [ [1,2,1], [3,-1,1], [0,4,1], [2,2,1] ]$\nG : [ [0,0,1], [1,0,1], [0,1,1], [2,3,4] ]$\n\nM : frame_map(F, G)$\nprint(\"M = \", M)$\nprint(\"\")$\nfor i : 1 thru 4 do\n  print(\"  F\", i, \" ↦ \", normalise(apply_proj(M, F[i])),\n        \"    target \", normalise(G[i]),\n        \"    match: \", same_point(apply_proj(M, F[i]), G[i]))$\n\n/* --- Uniqueness: a projectivity fixing the standard frame is the identity --- */\nMsym : matrix([m11,m12,m13],[m21,m22,m23],[m31,m32,m33])$\nE1 : [1,0,0]$  E2 : [0,1,0]$  E3 : [0,0,1]$  U : [1,1,1]$\n\n/* Fixing E1, E2, E3 forces the off-diagonal entries to vanish */\neqs : []$\nfor k in [[E1,1],[E2,2],[E3,3]] do block([img, i],\n  img : apply_proj(Msym, k[1]),\n  for i : 1 thru 3 do\n    if i # k[2] then eqs : cons(img[i] = 0, eqs) )$\nprint(\"\")$\nprint(\"fixing E1, E2, E3 requires: \", eqs)$\n\nsol : solve(eqs, [m12,m13,m21,m23,m31,m32])[1]$\nMdiag : subst(sol, Msym)$\nprint(\"so M is diagonal: \", Mdiag)$\n\n/* Now also fixing U forces the diagonal entries to be equal */\nimgU : apply_proj(Mdiag, U)$\nprint(\"M·U = \", imgU, \"  — proportional to (1,1,1) only if m11 = m22 = m33\")$\nprint(\"hence M is a scalar matrix, i.e. the identity of PGL(3) ∎\")$",
      "metadata": {},
