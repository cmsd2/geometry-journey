      "cell_type": "code",
      "source": "/* --- A torus mesh: χ = 0, and the defects must cancel --- */\nmgrid : 6$  ngrid : 8$\nidx(i,j) := mod(i-1, mgrid)*ngrid + mod(j-1, ngrid) + 1$\ntorV : makelist( makelist(\n         block([u, v], u : 2*%pi*(i-1)/mgrid, v : 2*%pi*(j-1)/ngrid,\n           [ float((2 + cos(u))*cos(v)), float((2 + cos(u))*sin(v)),\n             float(sin(u)) ]),\n         j, 1, ngrid), i, 1, mgrid)$\ntorV : apply(append, torV)$\ntorF : []$\nfor i:1 thru mgrid do for j:1 thru ngrid do\n  torF : append(torF, [ [idx(i,j), idx(i+1,j), idx(i,j+1)],\n                        [idx(i+1,j), idx(i+1,j+1), idx(i,j+1)] ])$\n\nprint(\"TORUS, a 6 × 8 grid of quads split into triangles:\")$\nreport(torV, torF, \"torus of revolution (tube 1, centre 2)\")$\ndt : defects(torV, torF)$\nprint(\"      most positive defect = \", lmax(dt))$\nprint(\"      most negative defect = \", lmin(dt))$\nprint(\"      They cancel to machine precision.  4.06 found this torus has\")$\nprint(\"      K > 0 on the outside and K < 0 on the inside, and 5.06 showed\")$\nprint(\"      ∫K dA = 0 exactly.  Here the SAME cancellation happens with no\")$\nprint(\"      integral and no smoothness — just 48 vertices and their angles.\")$\n\n/* --- deform it and nothing changes --- */\nprint(\"\")$\nprint(\"TOPOLOGICAL, NOT GEOMETRIC.  Deform the icosahedron by scaling\")$\nprint(\"vertex i by (1 + i/20), destroying every symmetry it had:\")$\nicoD : makelist( block([s], s : 1 + i/20,\n                  [ s*icoV[i][1], s*icoV[i][2], s*icoV[i][3] ]),\n                i, 1, length(icoV))$\nreport(icoD, icoF, \"deformed icosahedron\")$\ndD : defects(icoD, icoF)$\nprint(\"      individual defects, original  : \",\n      makelist( float(defects(icoV,icoF)[i]), i, 1, 4), \" ...\")$\nprint(\"      individual defects, deformed  : \",\n      makelist( float(dD[i]), i, 1, 4), \" ...\")$\nprint(\"   Every vertex now has a different curvature, and the total is\")$\nprint(\"   unmoved.  Σ Kᵥ measures the topology and nothing else — which is\")$\nprint(\"   exactly the character 5.06 identified for a characteristic class.\")$\n\nprint(\"\")$\nprint(\"A CAVEAT ON 'EXACT'.  The identity Σ Kᵥ = 2πχ is exact as algebra;\")$\nprint(\"the residuals above are of order 10⁻¹⁵, which is floating-point\")$\nprint(\"round-off in the arccosines, not discretisation error.  Refining\")$\nprint(\"the mesh would not reduce a discretisation error here, because\")$\nprint(\"there is none to reduce.\")$",
