      "cell_type": "code",
      "source": "load(\"linearalgebra\")$\n\n/* --- the cotangent Laplacian --- */\n/* cot of the angle at C in the triangle A,B,C */\ncot_at(A,B,C) := block([u, v, cr],\n  u : sub3(A,C), v : sub3(B,C),\n  cr : [ u[2]*v[3]-u[3]*v[2], u[3]*v[1]-u[1]*v[3], u[1]*v[2]-u[2]*v[1] ],\n  float( dot3(u,v) / nrm3(cr) ) )$\n\ncotan_L(V, F) := block([nv, W, D],\n  nv : length(V),\n  W : zeromatrix(nv, nv),\n  for f in F do block([a, b, c],\n    a : f[1], b : f[2], c : f[3],\n    /* edge (a,b) is opposite vertex c, and so on */\n    W[a,b] : W[a,b] + cot_at(V[a],V[b],V[c])/2,\n    W[b,a] : W[b,a] + cot_at(V[a],V[b],V[c])/2,\n    W[b,c] : W[b,c] + cot_at(V[b],V[c],V[a])/2,\n    W[c,b] : W[c,b] + cot_at(V[b],V[c],V[a])/2,\n    W[c,a] : W[c,a] + cot_at(V[c],V[a],V[b])/2,\n    W[a,c] : W[a,c] + cot_at(V[c],V[a],V[b])/2 ),\n  D : zeromatrix(nv, nv),\n  for i:1 thru nv do D[i,i] : sum(W[i,j], j, 1, nv),\n  D - W )$\n\nLico : cotan_L(icoV, icoF)$\nprint(\"COTANGENT LAPLACIAN on the icosahedron (12 × 12).\")$\nprint(\"   symmetric ?  max |L − Lᵀ| = \",\n      lmax( map(abs, flatten(args( Lico - transpose(Lico) ))) ))$\nprint(\"   row sums (constants are in the kernel) : max |Σⱼ L_ij| = \",\n      lmax( makelist( abs(sum(Lico[i,j], j, 1, 12)), i, 1, 12) ))$\nprint(\"   Both are structural, not numerical: the weight on edge ij is the\")$\nprint(\"   same seen from either end, and D was built as the row sum of W.\")$\n\n/* spectrum */\nev : eigens_by_jacobi( Lico )$\nevs : sort( makelist( float(ev[1][i]), i, 1, 12) )$\nprint(\"\")$\nprint(\"   eigenvalues, sorted:\")$\nprint(\"      \", makelist( round(evs[i]*1000)/1000.0, i, 1, 12))$\nprint(\"   One zero (the constants), then a triple, a quintuple and a\")$\nprint(\"   triple — the dimensions of the icosahedral group's irreducible\")$\nprint(\"   representations.  On the smooth sphere the Laplacian's\")$\nprint(\"   eigenspaces are the spherical harmonics, of dimensions\")$\nprint(\"   2ℓ+1 = 1, 3, 5, 7, …; the mesh reproduces the first two and\")$\nprint(\"   then runs out of vertices.\")$\n\n/* --- linear precision --- */\n/* A single interior vertex with a deliberately irregular 1-ring, in the\n   plane.  For a PLANAR mesh the cotangent Laplacian annihilates linear\n   functions exactly — that is what 'linearly precise' means, and it is\n   the property that makes the operator a genuine discretisation of Δ. */\nringV : [ [0,0,0],\n          [1.0, 0.0, 0], [0.6, 0.9, 0], [-0.4, 1.1, 0], [-1.3, 0.2, 0],\n          [-0.5,-0.8, 0], [0.7,-1.2, 0] ]$\nringF : [ [1,2,3],[1,3,4],[1,4,5],[1,5,6],[1,6,7],[1,7,2] ]$\nLring : cotan_L(ringV, ringF)$\nprint(\"\")$\nprint(\"LINEAR PRECISION.  A planar fan: one interior vertex, six neighbours\")$\nprint(\"at irregular positions.\")$\nfor lin in [ [3, -2, 5], [1, 0, 0], [0, 1, 0] ] do block([fv, Lf],\n  fv : makelist( lin[1]*ringV[i][1] + lin[2]*ringV[i][2] + lin[3],\n                 i, 1, 7),\n  Lf : Lring . transpose(matrix(fv)),\n  print(\"   f = \", lin[1], \"x + \", lin[2], \"y + \", lin[3],\n        \"   (Lf) at the interior vertex = \", Lf[1][1]) )$\nprint(\"   Zero to round-off for every linear f.  The cotangent weights are\")$\nprint(\"   not a plausible-looking guess: they are what the finite-element\")$\nprint(\"   derivation with piecewise-linear hat functions produces, and this\")$\nprint(\"   test is what they are for.  Uniform (graph) weights fail it on\")$\nprint(\"   any irregular mesh:\")$\nWg : zeromatrix(7,7)$\nfor f in ringF do for p in [[f[1],f[2]],[f[2],f[3]],[f[3],f[1]]] do\n  ( Wg[p[1],p[2]] : 1, Wg[p[2],p[1]] : 1 )$\nDg : zeromatrix(7,7)$\nfor i:1 thru 7 do Dg[i,i] : sum(Wg[i,j], j, 1, 7)$\nLg : Dg - Wg$\nfv2 : makelist( 3*ringV[i][1] - 2*ringV[i][2] + 5, i, 1, 7)$\nprint(\"      uniform-weight Laplacian on f = 3x − 2y + 5 : \",\n      (Lg . transpose(matrix(fv2)))[1][1], \"   ≠ 0\")$\nprint(\"   The graph Laplacian sees only the combinatorics; the cotangent\")$\nprint(\"   Laplacian sees the geometry.  That is the difference between a\")$\nprint(\"   mesh as a graph and a mesh as a surface.\")$",
