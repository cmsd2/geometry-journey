    {
      "cell_type": "code",
      "source": "/* --- SL(2,ℂ) → SO⁺(1,3), the double cover --- */\n/* NOTE: coordinates are named tv,xv,yv,zv, not t,x,y,z — assigning x or y\n   would break the plot ranges in the next cell (a trap this repo has hit\n   twice before). */\ndeclare([tv, xv, yv, zv, phv], real)$\nXmat(t_, x_, y_, z_) := matrix([t_ + z_, x_ - %i*y_],\n                               [x_ + %i*y_, t_ - z_])$\nXv : Xmat(tv, xv, yv, zv)$\n\nprint(\"the Hermitian-matrix picture of a 4-vector:\")$\nprint(\"   X(v) = \", Xv)$\nprint(\"   det X = \", ratsimp(determinant(Xv)))$\nprint(\"   det X + ⟨v,v⟩ = \", ratsimp( determinant(Xv)\n                                      + mink([tv,xv,yv,zv],[tv,xv,yv,zv]) ))$\nprint(\"   so the Minkowski norm IS a determinant.  Anything preserving\")$\nprint(\"   det therefore acts by Lorentz transformations.\")$\n\n/* A generic element of SL(2,ℂ), with real and imaginary parts written out.\n   Declaring the entries real would let Maxima silently drop the complex\n   conjugation in A† and prove only the SL(2,ℝ) case. */\ndeclare([a1,a2,b1,b2,c1,c2,d1_,d2], real)$\nAc  : matrix([a1+%i*a2, b1+%i*b2],[c1+%i*c2, d1_+%i*d2])$\nAdc : conjugate(transpose(Ac))$\ndetA : determinant(Ac)$\nprint(\"\")$\nprint(\"   for ANY A ∈ GL(2,ℂ):\")$\nprint(\"      det(A X A†) − |det A|² det X = \",\n      ratsimp( determinant(Ac . Xv . Adc)\n               - detA*conjugate(detA)*determinant(Xv) ))$\nprint(\"   so det A = 1 ⟹ |det A|² = 1 ⟹ det is preserved ⟹ X ↦ A X A†\")$\nprint(\"   is a Lorentz transformation.  SL(2,ℂ) acts on Minkowski space.\")$\n\n/* boosts */\nAb : matrix([exp(phv/2), 0],[0, exp(-phv/2)])$\nXb : ratsimp( Ab . Xv . conjugate(transpose(Ab)) )$\ntt2 : ratsimp( (Xb[1][1] + Xb[2][2])/2 )$\nzz2 : ratsimp( (Xb[1][1] - Xb[2][2])/2 )$\nxx2 : ratsimp( (Xb[1][2] + Xb[2][1])/2 )$\nyy2 : ratsimp( %i*(Xb[1][2] - Xb[2][1])/2 )$\nprint(\"\")$\nprint(\"   A = diag(e^{φ/2}, e^{−φ/2}) :\")$\nprint(\"      t′ = \", hs(tt2))$\nprint(\"      z′ = \", hs(zz2))$\nprint(\"      x′ = \", xx2, \"     y′ = \", yy2)$\nboostz : matrixmap(hs, matrixexp(phv*K3))$\npred : boostz . transpose(matrix([tv,xv,yv,zv]))$\nprint(\"      compared with exp(φK₃) applied to v, difference = \",\n      hs( [tt2,xx2,yy2,zz2]\n          - [pred[1][1],pred[2][1],pred[3][1],pred[4][1]] ))$\nprint(\"      A boost in z, exactly.  SU(2) ⊂ SL(2,ℂ) gives the rotations\")$\nprint(\"      in the same way — the case 1.03 and 5.01 already did.\")$\n\nprint(\"\")$\nprint(\"   ±A give the SAME Lorentz transformation:\")$\nprint(\"      (−A)X(−A)† − A X A† = \",\n      ratsimp( (-Ab) . Xv . conjugate(transpose(-Ab)) - Xb ))$\nprint(\"   So SL(2,ℂ) → SO⁺(1,3) is 2-to-1: a double cover, exactly as\")$\nprint(\"   SU(2) → SO(3) was in 1.03.  One signature over, same phenomenon —\")$\nprint(\"   and the reason spinors exist in relativity at all.\")$\n\nprint(\"\")$\nprint(\"   dimension check:  sl(2,ℂ) as a REAL Lie algebra has dimension \",\n      2*(2^2-1), \" = 2(n²−1) with n = 2,\")$\nprint(\"   and dim so(1,3) = \", 4*3/2, \".  Equal ✓, as an isomorphism needs.\")$\nprint(\"   The duality m ↦ i·m that 5.04 used to turn so(3) into so(2,1) is\")$\nprint(\"   the same complexification seen from the other side.\")$",
      "metadata": {},
