    {
      "cell_type": "code",
      "source": "/* --- The Einstein tensor  G = Ric − (S/2) g  --- */\neinstein_hand(g, vars) := ratsimp( ricci_hand(g,vars)\n                                   - (scalar_hand(g,vars)/2) * g )$\n\nprint(\"Einstein tensor in dimension 2:\")$\nprint(\"   sphere     : \", einstein_hand(g_sph, [u,v]))$\nprint(\"   hyperbolic : \", einstein_hand(g_hyp, [x,y]))$\n\n/* a general surface of revolution — no constant-curvature assumption */\ndepends(f, u)$\ng_rev : matrix([1,0],[0,f^2])$\nprint(\"\")$\nprint(\"   a general surface of revolution, g = \", g_rev, \" with f = f(u):\")$\nprint(\"      K   = \", ts( -diff(f,u,2)/f ), \"   (= −f''/f, as 3.04 found)\")$\nprint(\"      Ric = \", ricci_hand(g_rev, [u,v]))$\nprint(\"      S   = \", scalar_hand(g_rev, [u,v]))$\nprint(\"      G   = \", einstein_hand(g_rev, [u,v]))$\nprint(\"\")$\nprint(\"G vanishes identically in dimension 2, for ANY metric: with only one\")$\nprint(\"curvature component, Ric = K g and S = 2K, so Ric − (S/2)g = 0.\")$\nprint(\"The Einstein field equations G = 8πT would then force T = 0 — which is\")$\nprint(\"why there is no 2-dimensional general relativity worth the name.\")$\nremove(f, dependency)$",
      "metadata": {},
      "execution_count": 4,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Einstein tensor in dimension 2:\n   sphere     :  matrix([0,0],[0,0])\n   hyperbolic :  matrix([0,0],[0,0])\n   a general surface of revolution, g =\n  matrix([1,0],[0,f^2])  with f = f(u):\n      K   =  -('diff(f,u,2)/f)    (= −f''/f, as 3.04 found)\n      Ric =  matrix([-('diff(f,u,2)/f),0],[0,-(f*'diff(f,u,2))])\n      S   =  -((2*'diff(f,u,2))/f)\n      G   =  matrix([0,0],[0,0])\nG vanishes identically in dimension 2, for ANY metric: with only one\ncurvature component, Ric = K g and S = 2K, so Ric − (S/2)g = 0.\nThe Einstein field equations G = 8πT would then force T = 0 — which is\nwhy there is no 2-dimensional general relativity worth the name."
          ]
        }
