    {
      "cell_type": "code",
      "source": "/* --- Killing fields: the Erlangen group, recovered from the metric --- */\n/* X is Killing iff the Lie derivative of g along X vanishes:\n      (L_X g)_ij = X^k ∂_k g_ij + g_kj ∂_i X^k + g_ik ∂_j X^k = 0. */\nlie_g(g, vars, X) := block([n_],\n  n_ : length(vars),\n  genmatrix( lambda([i,j], ts(\n      sum( X[k]*diff(g[i][j], vars[k]), k,1,n_)\n    + sum( g[k][j]*diff(X[k], vars[i]), k,1,n_)\n    + sum( g[i][k]*diff(X[k], vars[j]), k,1,n_) )), n_, n_) )$\n\nprint(\"EUCLIDEAN PLANE, g = dx² + dy²\")$\ngE : matrix([1,0],[0,1])$\nfor X in [[1,0], [0,1], [-y, x]] do\n  print(\"   X = \", X, \"   L_X g = \", lie_g(gE, [x,y], X))$\nprint(\"   two translations and one rotation: dim Isom = 3 = ½n(n+1) ✓\")$\nprint(\"   that is E(2), the group of 1.02–1.04.\")$\n\nprint(\"\")$\nprint(\"UNIT SPHERE, g = du² + sin²u dv²   (u polar, v azimuthal)\")$\ngS : matrix([1,0],[0,sin(u)^2])$\nfor X in [[0, 1],\n          [sin(v), cos(v)*cos(u)/sin(u)],\n          [cos(v), -sin(v)*cos(u)/sin(u)]] do (\n  print(\"   X = \", X),\n  print(\"      L_X g = \", lie_g(gS, [u,v], X)) )$\nprint(\"   the three rotations about the coordinate axes: dim = 3 ✓\")$\nprint(\"   that is SO(3), the group of 2.07.\")$\n\nprint(\"\")$\nprint(\"HYPERBOLIC HALF-PLANE, g = (dx² + dy²)/y²\")$\ngH : matrix([1/y^2,0],[0,1/y^2])$\nfor X in [[1, 0], [x, y], [x^2-y^2, 2*x*y]] do\n  print(\"   X = \", X, \"   L_X g = \", lie_g(gH, [x,y], X))$\nprint(\"   translation, dilation, special conformal: dim = 3 ✓\")$\nprint(\"   these are the generators of PSL₂(ℝ), the group of 2.06.\")$\nprint(\"   In the complex coordinate z = x + iy the three fields are\")$\nprint(\"   1, z and z², whose flows are z ↦ z+t, z ↦ e^t z and\")$\nprint(\"   z ↦ z/(1−tz) — Möbius transformations, which is exactly what\")$\nprint(\"   2.06 obtained from circle geometry with no metric in sight.\")$\n\nprint(\"\")$\nprint(\"A SURFACE THAT IS NOT A SPACE FORM: torus of revolution\")$\ngT : matrix([1,0],[0,(2+cos(u))^2])$\nprint(\"   X = \", [0,1], \"   L_X g = \", lie_g(gT, [u,v], [0,1]),\n      \"   (rotation ✓)\")$\nprint(\"   X = \", [1,0], \"   L_X g = \", lie_g(gT, [u,v], [1,0]))$\nprint(\"      not Killing — the offending entry is ∂_u(f²) ≠ 0.\")$\nprint(\"   Its curvature is non-constant (4.06), so dim Isom < 3.  Maximal\")$\nprint(\"   symmetry and constant curvature are the same condition.\")$",
      "metadata": {},
