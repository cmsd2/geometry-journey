      "osculating circle at (3,0): centre  [1.6666666666666667,0.0]  radius\n                                   1.3333333333333333\nosculating circle at (0,2): centre  [0.0,-2.5]  radius  4.5"
     ]
    },
    {
     "data": {
      "image/svg+xml": [
